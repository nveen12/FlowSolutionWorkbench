			sSQL = "INSERT INTO MRP_DEMAND  (ORGANIZATION_ID, DEMAND_ID, INVENTORY_ITEM_ID, ITEM_NO, DESCRIPTION, MRP_QTY, MRP_DATE, ORIGINATION_TYPE, PARENT_JOB_ORDER_ID, parentJobOrderNo, parentJobStatus, parentJobOrderLeadTime, USING_ASSEMBLY_ITEM_ID, usingAssemblyLeadTime, COMPILE_DESIGNATOR, PROJECT_ID, MAKE_BUY, WIP_SUPPLY_TYPE, PLANNER_CODE, LEVEL_NO, END_DEMAND_ID)  " & _
			  "SELECT b.ORGANIZATION_ID, d.DEMAND_ID * 100 + b.WIP_ENTITY_ID + b.OPERATION_SEQ_NO + b.INVENTORY_ITEM_ID AS DEMAND_ID, b.INVENTORY_ITEM_ID, b.ITEM_NO, b.DESCRIPTION, b.REQUIRED_QUANTITY - b.QUANTITY_ISSUED AS MRP_QTY, DATEADD(d, -d.jobDuration, d.MRP_DATE) AS MRP_DATE, 3 AS ORIGINATION_TYPE, b.WIP_ENTITY_ID AS PARENT_JOB_ORDER_ID, b.JOB_NO AS parentJobOrderNo, b.STATUS_TYPE AS parentJobStatus, d.jobDuration AS parentJobOrderLeadtime, d.INVENTORY_ITEM_ID AS USING_ASSEMBLY_ITEM_ID, 0 AS usingAssemblyLeadTime, 'FAKE' AS COMPILE_DESIGNATOR, CASE WHEN b.seiban_controlled IS NULL THEN NULL ELSE b.PROJECT_ID END AS PROJECT_ID, i.PLANNING_MAKE_BUY_CODE AS MAKE_BUY, b.WIP_SUPPLY_TYPE, i.PLANNER_CODE, ISNULL(1 + d.LEVEL_NO, 1) AS LEVEL_NO, d.END_DEMAND_ID " & _
			  "FROM dbo.open_boms AS b FULL OUTER JOIN dbo.mrp_demand AS d ON b.WIP_ENTITY_ID = d.JOB_ID AND b.ORGANIZATION_ID = d.ORGANIZATION_ID " & _
			  "LEFT OUTER JOIN dbo.pjmSeibanNumbers AS s ON b.PROJECT_ID = s.PROJECT_ID " & _
			  "LEFT OUTER JOIN dbo.active_items AS i ON b.INVENTORY_ITEM_ID = i.INVENTORY_ITEM_ID AND b.ORGANIZATION_ID = i.ORGANIZATION_ID " & _
			  "LEFT OUTER JOIN dbo.mrp_demand AS d1 ON b.ORGANIZATION_ID = d1.ORGANIZATION_ID AND b.INVENTORY_ITEM_ID = d1.INVENTORY_ITEM_ID AND b.WIP_ENTITY_ID = d1.PARENT_JOB_ORDER_ID " & _
			  "WHERE (d1.ORGANIZATION_ID IS NULL) AND (NOT (b.ITEM_TYPE LIKE 'REF')) AND (NOT (b.ITEM_TYPE LIKE 'PH')) AND (b.QUANTITY_ISSUED < b.REQUIRED_QUANTITY) AND (i.MRP_PLANNING_CODE <> 6) AND (d.JOB_ID IS NOT NULL) " & _
			  "GROUP BY b.JOB_NO, b.OPERATION_SEQ_NO, b.PROJECT_ID, b.SEIBAN_CONTROLLED, b.INVENTORY_ITEM_ID, b.ITEM_NO, b.DESCRIPTION, b.ORGANIZATION_ID, b.REQUIRED_QUANTITY - b.QUANTITY_ISSUED, DATEADD(d, -d.jobDuration, d.MRP_DATE), b.WIP_ENTITY_ID, b.STATUS_TYPE, d.jobDuration, i.PLANNING_MAKE_BUY_CODE, b.WIP_SUPPLY_TYPE, i.PLANNER_CODE, ISNULL(1 + d.LEVEL_NO, 1), d.DEMAND_ID * 100 + b.WIP_ENTITY_ID + b.OPERATION_SEQ_NO + b.INVENTORY_ITEM_ID, d.INVENTORY_ITEM_ID, d.END_DEMAND_ID"

			dbS.NonQuery(sSQL)

		Catch ex As Exception
			createErrorLog("InsertMissingDemand", ex)
		Finally
			dbS.Disconnect()
		End Try

