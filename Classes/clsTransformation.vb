	''' <summary>
	''' Constructor of the class which performs a check on the backend.
	''' </summary>
	''' <param name="serverTime">The instantation time of the object.</param>
	''' <remarks></remarks>
	Public Sub New(ByVal serverTime As Date, ByVal runningInstance As String)

		Try
			runningInst = runningInstance
			instTime = serverTime
		Finally

		End Try

	End Sub

    ''' <summary>
    ''' Main function for the transformation run.
    ''' </summary>
    ''' <returns> A 0 when everything operates and a 1 if somethin fails.</returns>
	Public Function runTransformation()
        'sendFailureMessagesOnTransactions()
        CalculateShortages()

        'for validating the transactions from Autobahn to Oracle. (temporary spot for these)
		If runningInst = "validate" Then
			validatePickReleases()
			validatePOPromiseDates()
            validateJobStartDates()
            sendFailureMessagesOnTransactions()
        ElseIf runningInst = "validateASCP" Then
            validatePickReleases("ASCP")
            validatePOPromiseDates("ASCP")
            validateJobStartDates("ASCP")
            sendFailureMessagesOnTransactions()

        ElseIf runningInst = "waitForChesMRP" Then
            waitForMRP("CHP", 881)
        ElseIf runningInst = "monitorMRPNow" Then
            Me.monitorMRPforStar()
        ElseIf runningInst = "importIncremental" Then
            Me.recalculateCumulativeShort()
        ElseIf runningInst = "updateUserInformation" Then
            Me.UpdateAllUsersInfo()
        Else

            'transformation
            cleanse_dw_items()
            PrepareToCalculateShortages()
            CalculateShortages()
            If runningInst = "STAR" Then
                InsertMissingDemand()
                PrepareToCalculateShortages() 'have to do these two steps again because we have new MRP Demand records. not generated by Oracle due to soft peg project material.
                CalculateShortages()
                InsertMissingDemand()
                PrepareToCalculateShortages() 'have to do these two steps again because we have new lower level MRP Demand records (usually very few!)
                CalculateShortages()
            End If
            EnrichOrderData()
            AttachComponentDetails()
            displayShortagesForOnHand()

            If runningInst = "STAR" Then CalculateCapacity() '*** this if statement is temporary, see procedure
        End If

        'Everything worked during the transformation process
        Return 0

	End Function

    Private Sub monitorMRPforStar()
        'Get the set of required information
        Dim dbo As New DB.ORacleServerDB(My.Settings.OracleSTARConnectionString)
        Dim d = Now
        Dim strDate As String = Now.AddDays(-2).ToString("dd-MM-yy HH:mm", CultureInfo.CreateSpecificCulture("en-EN")).ToUpper
        Dim ds As DataSet = dbo.Query("select * from FND_CONC_REQ_SUMMARY_V where request_date > to_date('" & strDate & "','DD-MM-YY HH24:MI') AND program_short_name = 'MRCEAP'")

        'Insert the values into the tracking table - Also compare to the standard completion time of these MRP's 
        'Send an EMail when they are missing and send a warning when they are 1 hour late
        For i As Integer = 0 To ds.Tables(0).Rows.Count - 1

        Next

    End Sub

    ''' <summary>
    ''' Procedure that makes the job stop when
    ''' </summary>
    ''' <param name="compileDesignator">The organization you want to check!</param>
    ''' <remarks></remarks>
    Private Sub waitForMRP(ByVal compileDesignator As String, ByVal organizationId As Integer)
        Dim dbO As New DB.ORacleServerDB(My.Settings.OracleSTARConnectionString)
        Dim dsO As New DataSet
        Dim bConnectSuccess As Boolean = True
        Dim time1 As DateTime = Now
        Dim time2 As DateTime = Now

        'We may run into connection timeouts
        Try
            dsO = dbO.Query("SELECT sysdate, last_update_date  FROM  mrp_plans WHERE  compile_designator LIKE  '%" & compileDesignator & "%'")
            time1 = dsO.Tables(0).Rows(0).Item(0)
            time2 = dsO.Tables(0).Rows(0).Item(1)
        Catch ex As Exception
            bConnectSuccess = False
            time1 = Now
            time2 = Now
        End Try

       

        ''We may have no connection success
        'If bConnectSuccess Then
        '    If Not DBNull.Value.Equals(dsO.Tables(0).Rows(0).Item(1)) Then
        '        time1 = dsO.Tables(0).Rows(0).Item(0)
        '        time2 = dsO.Tables(0).Rows(0).Item(1)
        '    End If
        'End If

        Dim timeSpan As TimeSpan = time1 - time2

        If timeSpan.TotalHours < 0.2 Or timeSpan.TotalHours > 18 Then
            For j As Integer = 0 To 9999999     'Loop, to find the
                Dim Thread1 As New System.Threading.Thread(AddressOf ControlOperation)
                Thread1.Sleep(3000)   'Wait for 5 minutes then retry
                Thread1.Start()

                time1 = Now
                time2 = Now
                'find if the situation has changed
                Try
                    dsO = dbO.Query("SELECT sysdate, last_update_date  FROM  mrp_plans WHERE  compile_designator LIKE  '%" & compileDesignator & "%'")
                    bConnectSuccess = True
                    time1 = dsO.Tables(0).Rows(0).Item(0)
                    time2 = dsO.Tables(0).Rows(0).Item(1)
                Catch ex As Exception
                    bConnectSuccess = False
                    time1 = Now
                    time2 = Now
                End Try

                ''We may have no connection success
                'If bConnectSuccess Then
                '    If Not DBNull.Value.Equals(dsO.Tables(0).Rows(0).Item(1)) Then
                '        time1 = dsO.Tables(0).Rows(0).Item(0)
                '        time2 = dsO.Tables(0).Rows(0).Item(1)
                '    End If
                'End If

                timeSpan = time1 - time2
                If timeSpan.TotalHours > 0.2 AndAlso timeSpan.TotalHours < 18 Then
                    Exit For

                End If
            Next

        Else

        End If

        time1 = Now
        time2 = Now

        dsO = Nothing

        bConnectSuccess = True
        Try
            dsO = dbO.Query("SELECT sysdate, max(MRP.last_update_date)  FROM  MRP_GROSS_REQUIREMENTS  MRP WHERE  MRP.organization_id = " & organizationId.ToString & "")
            time1 = dsO.Tables(0).Rows(0).Item(0)
            time2 = dsO.Tables(0).Rows(0).Item(1)
        Catch ex As Exception
            bConnectSuccess = False
            time1 = Now
            time2 = Now
        End Try

        'If bConnectSuccess Then
        '    If Not DBNull.Value.Equals(dsO.Tables(0).Rows(0).Item(1)) Then
        '        time1 = dsO.Tables(0).Rows(0).Item(0)
        '        time2 = dsO.Tables(0).Rows(0).Item(1)
        '    End If
        'End If

        timeSpan = time1 - time2

        If timeSpan.TotalHours < 0.7 Or timeSpan.TotalHours > 18 Then
            For j As Integer = 0 To 9999999     'Loop, to find the
                Dim Thread1 As New System.Threading.Thread(AddressOf ControlOperation)
                Thread1.Sleep(3000)   'Wait for 5 minutes then retry
                Thread1.Start()

                time1 = Now
                time2 = Now

                Try
                    'find if the situation has changed
                    dsO = dbO.Query("SELECT sysdate, max(MRP.last_update_date)  FROM  MRP_GROSS_REQUIREMENTS  MRP WHERE  MRP.organization_id = " & organizationId.ToString & "")
                    bConnectSuccess = True
                    time1 = dsO.Tables(0).Rows(0).Item(0)
                    time2 = dsO.Tables(0).Rows(0).Item(1)
                Catch ex As Exception
                    bConnectSuccess = False
                    time1 = Now
                    time2 = Now
                End Try

                'If bConnectSuccess Then     'Check for connection and if we really have values in the table otherwise keep on waiting
                '    If Not DBNull.Value.Equals(dsO.Tables(0).Rows(0).Item(0)) Then
                '        time1 = dsO.Tables(0).Rows(0).Item(0)
                '        time2 = dsO.Tables(0).Rows(0).Item(1)
                '    End If
                'End If
                
                timeSpan = time1 - time2
                If timeSpan.TotalHours > 0.7 AndAlso timeSpan.TotalHours < 18 Then       'Should not exit after 10 minutes, wait 
                    Exit For
                End If
            Next

        Else
            Application.Exit()
        End If







    End Sub
