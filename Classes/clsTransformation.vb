	''' <summary>
	''' Update the item table of the data warehouse
	''' </summary>
	''' <remarks>rewrote most of procedure 10/26/10 (RobH)</remarks>
	Private Sub cleanse_dw_items()
		Try

            Dim x As Integer
            Dim y As Integer
            Dim sTmp As String
            Dim sSQL As String
            Dim sTable(0 To 3) As String
            Dim sColumn(0 To 6) As String

            db.Connect()
            createLoggingStamp("cleanse_dw_items")

            'MAKE A LIST OF ALL ACTIVE ITEMS - to use for item-related queries, much faster than using the full items table
            'Insert all active items into the working table
            db.NonQuery("DELETE FROM work_table1")
            db.NonQuery("INSERT INTO work_table1 (number1, number2)  (SELECT inventory_item_id, organization_id FROM open_boms              GROUP BY inventory_item_id, organization_id)")      'Open WIP Bill of materials
            db.NonQuery("INSERT INTO work_table1 (number1, number2)  (SELECT inventory_item_id, organization_id FROM sales_orders           GROUP BY inventory_item_id, organization_id)")      'Open sales orders
            db.NonQuery("INSERT INTO work_table1 (number1, number2)  (SELECT inventory_item_id, organization_id FROM jobs                   GROUP BY inventory_item_id, organization_id)")      'Open jobs
            db.NonQuery("INSERT INTO work_table1 (number1, number2)  (SELECT inventory_item_id, organization_id FROM items_qty_oh           GROUP BY inventory_item_id, organization_id)")      'QTY on hand
            db.NonQuery("INSERT INTO work_table1 (number1, number2)  (SELECT inventory_item_id, organization_id FROM items_safety_stock     GROUP BY inventory_item_id, organization_id)")      'Safety stocks
            db.NonQuery("INSERT INTO work_table1 (number1, number2)  (SELECT inventory_item_id, organization_id FROM mrp_demand             GROUP BY inventory_item_id, organization_id)")      'MRP demand
            db.NonQuery("INSERT INTO work_table1 (number1, number2)  (SELECT inventory_item_id, ship_to_organization_id FROM po             GROUP BY inventory_item_id, ship_to_organization_id)")  'po's 
            'Group another time to eliminate duplicates, clear destination table
            db.NonQuery("DELETE FROM work_table2")
            db.NonQuery("INSERT INTO work_table2 (number1, number2) (SELECT wt1.number1, wt1.number2 FROM work_table1 wt1 GROUP BY wt1.number1, wt1.number2)")
            db.NonQuery("DELETE FROM active_items")
            'Insert unique items into active items table.
            sSQL = "INSERT INTO active_items (INVENTORY_ITEM_ID, ITEM_NO, DESCRIPTION, ORGANIZATION_ID, FULL_LEAD_TIME, FIXED_LEAD_TIME, STD_LOT_SIZE, PLANNING_MAKE_BUY_CODE, ITEM_COST, ITEM_TYPE, BOM_ITEM_TYPE, MINIMUM_ORDER_QUANTITY, FIXED_LOT_MULTIPLIER, PLANNER_CODE, WIP_SUPPLY_TYPE, WIP_SUPPLY_LOCATOR_ID, WIP_SUPPLY_SUBINVENTORY, ITEM_CATALOG_GROUP_ID, LAST_UPDATE_DATE_CST, CREATION_DATE_MSI, LAST_UPDATE_DATE_MSI, START_DATE_ACTIVE, END_DATE_ACTIVE, QTY_ONHAND, QTY_WIP, QTY_ALLOCATED, QTY_ALLOC_JOB, QTY_ON_ORDER, SAFETY_STOCK_QUANTITY, CREATED_BY, CREATION_DATE, LAST_UPDATED_BY, LAST_UPDATE_DATE, LAST_UPDATE_LOGIN, UNIT_WEIGHT, WEIGHT_UOM_CODE, VOLUME_UOM_CODE, PRIMARY_UOM_CODE, PRIMARY_UNIT_OF_MEASURE, BUYER, ITEM_STATUS, MAX_MINMAX_QUANTITY, MIN_MINMAX_QUANTITY, MRP_PLANNING_CODE) " & _
               " SELECT i.INVENTORY_ITEM_ID, i.ITEM_NO, i.DESCRIPTION, i.ORGANIZATION_ID, i.FULL_LEAD_TIME, i.FIXED_LEAD_TIME, i.STD_LOT_SIZE, i.PLANNING_MAKE_BUY_CODE, i.ITEM_COST, i.ITEM_TYPE, i.BOM_ITEM_TYPE, i.MINIMUM_ORDER_QUANTITY, i.FIXED_LOT_MULTIPLIER, i.PLANNER_CODE, i.WIP_SUPPLY_TYPE, i.WIP_SUPPLY_LOCATOR_ID, i.WIP_SUPPLY_SUBINVENTORY, i.ITEM_CATALOG_GROUP_ID, i.LAST_UPDATE_DATE_CST, i.CREATION_DATE_MSI, i.LAST_UPDATE_DATE_MSI, i.START_DATE_ACTIVE, i.END_DATE_ACTIVE, i.QTY_ONHAND, i.QTY_WIP, i.QTY_ALLOCATED, i.QTY_ALLOC_JOB, i.QTY_ON_ORDER, i.SAFETY_STOCK_QUANTITY, i.CREATED_BY, i.CREATION_DATE, i.LAST_UPDATED_BY, i.LAST_UPDATE_DATE, i.LAST_UPDATE_LOGIN, i.UNIT_WEIGHT, i.WEIGHT_UOM_CODE, i.VOLUME_UOM_CODE, i.PRIMARY_UOM_CODE, i.PRIMARY_UNIT_OF_MEASURE, i.BUYER, i.INVENTORY_ITEM_STATUS_CODE, i.MAX_MINMAX_QUANTITY, i.MIN_MINMAX_QUANTITY, i.MRP_PLANNING_CODE  " & _
              " FROM [items] i  INNER JOIN work_table2 w  ON i.inventory_item_id = w.number1 AND i.organization_id = w.number2 "
            db.NonQuery(sSQL)
            db.NonQuery("UPDATE active_items SET qty_onhand = 0, qty_wip = 0, qty_allocated = 0, qty_alloc_job = 0, qty_on_order = 0, safety_stock_quantity = 0") 'get rid of null values
            createLoggingStamp("cleanse_dw_items")

            ''COPY CATEGORIES AND DRAWINGS to the active items and open orders tables
            sTable(0) = "ACTIVE_ITEMS"
            sTable(1) = "JOBS"
            sTable(2) = "PO"
            sTable(3) = "SALES_ORDERS"
            sColumn(0) = "FSG_COMMODITY_CODE"
            sColumn(1) = "FSG_IND_PAINT_PARTS"
            sColumn(2) = "FSG_MATERIAL_CODE"
            sColumn(3) = "FSG_PRODUCT_CODE"
            sColumn(4) = "FSG_SALES_TYPE"
            sColumn(5) = "FSG_SPARES_CLASS"
            sColumn(6) = "DRAWING"
            'copy categories into active items table
            For x = 0 To 5
                If x = 3 Then sTmp = "+ '.' + ic.segment2 + '.' + ic.segment3 + '.' + ic.segment4 + '.' + ic.segment5 " Else sTmp = ""
                sSQL = "UPDATE t  SET " & sColumn(x) & " = ic.segment1" & sTmp & " FROM " & sTable(0) & " t  INNER JOIN itemCategories ic  " & _
                 "ON t.organization_id = t.organization_id AND t.inventory_item_id = ic.inventory_item_id AND ic.category_description LIKE '" & sColumn(x) & "'"
                db.NonQuery(sSQL)
            Next
            'copy drawing numbers into active items table 
            sSQL = "UPDATE ai  SET Drawing = d.Drawing FROM active_items ai INNER JOIN whOrganizationDefinition od ON ai.organization_ID = od.organizationID INNER JOIN Drawings d ON od.masterItemOrgID = d.organization_id  AND ai.inventory_item_id = d.inventory_item_id"
            db.NonQuery(sSQL)

            'copy the categories, drawing no's from active items to order tables
            For x = 1 To UBound(sTable)
                If sTable(x) = "PO" Then sTmp = "ship_to_" Else sTmp = "" 'we really should change this org id name in the po table ***
                sSQL = "UPDATE t  SET "
                For y = 0 To UBound(sColumn)
                    sSQL += sColumn(y) & " = t0." & sColumn(y) & ", "
                Next
                sSQL = Left(sSQL, Len(sSQL) - 2) 'get rid of the final comma 
                sSQL += "  FROM " & sTable(x) & " t  INNER JOIN " & sTable(0) & " t0 ON t." & sTmp & "organization_id = t0.organization_id AND t.inventory_item_id = t0.inventory_item_id "
                'keep the old values - no wipe out of already mapped columns
                For y = 0 To UBound(sColumn)
                    sSQL += " AND t." & sColumn(y) & " IS NOT NULL "
                Next

                db.NonQuery(sSQL)
            Next
            createLoggingStamp("cleanse_dw_items")

            'Copy latest safety stocks into active items table 
            db.NonQuery("DELETE FROM work_table1")
            db.NonQuery("INSERT INTO work_table1 (number1, number2, number3) (SELECT s1.organization_id, s1.inventory_item_id  " & _
              ", s1.safety_stock_quantity FROM items_safety_stock s1 WHERE s1.effectivity_date = (SELECT max(effectivity_date) ed " & _
              " FROM items_safety_stock s2 WHERE s1.inventory_item_id = s2.inventory_item_id " & _
              " AND s1.organization_id = s2.organization_id) AND s1.safety_stock_quantity > 0 )")
            db.NonQuery("UPDATE ai SET safety_stock_quantity = wt1.number3 FROM active_items ai JOIN work_table1 wt1 ON ai.organization_id = wt1.number1 " & _
              " AND ai.inventory_item_id = wt1.number2 ")

            'copy qty on hand to active items table  
            db.NonQuery("DELETE FROM work_table1")
            db.NonQuery("INSERT INTO work_table1 (number1, number2, number3) (SELECT organization_id, inventory_item_id, sum(qty_onhand) AS SumOfQtyOnhand FROM items_qty_oh " & _
               " GROUP BY organization_id, inventory_item_id)")
            db.NonQuery("UPDATE ai SET qty_onhand = wt1.number3 FROM active_items ai JOIN work_table1 wt1 ON ai.organization_id = wt1.number1 AND ai.inventory_item_id = wt1.number2")

            'copy qty on open PO's to active items table  
            db.NonQuery("DELETE FROM work_table1")
            db.NonQuery("INSERT INTO work_table1 (number1, number2, number3) (SELECT ship_to_organization_id, inventory_item_id, SUM(quantity_ordered - qty_received) AS qtyOnOrders FROM po GROUP BY ship_to_organization_id, inventory_item_id )")
            db.NonQuery("UPDATE ai SET qty_on_order = wt1.number3 FROM active_items ai JOIN work_table1 wt1 ON ai.organization_id = wt1.number1 AND ai.inventory_item_id = wt1.number2")

            'copy qty allocated for jobs to active items table  
            db.NonQuery("DELETE FROM work_table1")
            db.NonQuery("INSERT INTO work_table1 (number1, number2, number3) (SELECT organization_id, inventory_item_id, sum(required_quantity - quantity_issued) AS qtyAlloc " & _
             " FROM open_boms GROUP BY organization_id, inventory_item_id)")
            db.NonQuery("UPDATE ai SET qty_alloc_job = wt1.number3 FROM active_items ai JOIN work_table1 wt1 ON ai.organization_id = wt1.number1 AND ai.inventory_item_id = wt1.number2")

            'copy qty allocated to sales orders  to active items table
            db.NonQuery("DELETE FROM work_table1")
            db.NonQuery("INSERT INTO work_table1 (number1, number2, number3) (SELECT organization_id, inventory_item_id, Sum(ordered_quantity ) AS allocSO " & _
             " FROM sales_orders  GROUP BY organization_id, inventory_item_id)")
            db.NonQuery("UPDATE ai SET qty_allocated = wt1.number3 FROM active_items ai JOIN work_table1 wt1 ON ai.organization_id = wt1.number1 AND ai.inventory_item_id = wt1.number2")
            db.NonQuery("UPDATE po SET age = CONVERT(FLOAT,(getDate() - creation_date_pol))") 'age of PO's.  really should go in Enrich Order Data routine ***

            'Chesapeake specific item cleansing:
            db.NonQuery("UPDATE active_items SET planning_make_buy_code = 2 WHERE organization_id IN (881,882,883) AND planner_code LIKE 'S-CNTR'")

            createLoggingStamp("cleanse_dw_items")

        Catch ex As Exception
            createErrorLog("cleanse_dw_items", ex)
        Finally
            db.Disconnect()
        End Try

	End Sub



	'The MRP Dates are incorrect sometimes, because pump jobs are not scheduled to coincide with the sales order scheduled ship date
	'need to override the MRP Date with the true "Needed By" date
	'also, MRP ignores project inventory versus normal inventory in its planning, so we have to consider it separately rh09/2010
	Public Sub PrepareToCalculateShortages()
		Try

			Dim sSQL As String
			Dim sTmp As String
			Dim sTable(0 To 3) As String
			Dim x As Integer

			'Connect to the database
			dbS.Connect()
			createLoggingStamp("PrepareToCalculateShortages")

			dbS.NonQuery("UPDATE mrp_demand SET usingAssemblyLeadTime = NULL, parentJobOrderLeadTime = NULL, end_demand_id = NULL, level_no = NULL, purchase_order_id = NULL, purch_line_no = NULL, po_promised_date = NULL, purchase_order_no = NULL, qty_open = NULL, vendor_name = NULL, source_vendor_id = NULL, neededBy = NULL, PARENT_SALES_ORDER_ID = NULL, PARENT_SALES_ORDER_LINE = NULL, Short = NULL, temp = NULL, consumptionPriorityDate = NULL, job_id = NULL, job_no = NULL, start_quantity_hdr = NULL, start_date = NULL, status = NULL, jobDuration = NULL ")	'Reset the mrp demand table
			dbS.NonQuery("UPDATE sales_orders SET demand_id = NULL, short = NULL, job_no = NULL, po_no = NULL, qty_onhand = NULL ")	'Reset the sales orders table
			dbS.NonQuery("UPDATE po SET qty_onhand = NULL")
			dbS.NonQuery("UPDATE jobs SET qty_onhand = NULL")

			'copy wip supply type, make buy code, safety stock into MRP Demand
            sSQL = "UPDATE d SET WIP_SUPPLY_TYPE = i.WIP_SUPPLY_TYPE, " & _
            " SAFETY_STOCK_QUANTITY = i.SAFETY_STOCK_QUANTITY, MAKE_BUY = i.PLANNING_MAKE_BUY_CODE, PLANNER_CODE = i.PLANNER_CODE  " & _
             "FROM mrp_demand d  INNER JOIN active_items i  ON d.organization_id = i.organization_id " & _
             " AND d.inventory_item_id = i.inventory_item_id "
			dbS.NonQuery(sSQL)

			'POST JOB DURATIONS into mrp demand 
			dbS.NonQuery("DELETE FROM tblWork")
			sSQL = "INSERT INTO tblWork (Number1, Number2, Date1, Date2) SELECT d.organization_id, d.parent_job_order_id, Max(jobs.last_unit_completion_date), Min(jobs.first_unit_start_date)  " & _
			   "FROM mrp_demand d  INNER JOIN jobs  ON d.organization_id = jobs.organization_id AND d.parent_job_order_id = jobs.wip_entity_id  " & _
			   "GROUP BY d.organization_id, d.parent_job_order_id "
			dbS.NonQuery(sSQL)
			sSQL = "UPDATE d SET parentJobOrderLeadTime = ROUND(CONVERT(FLOAT, w.Date1 - w.Date2)+.51,0)  FROM mrp_demand d  INNER JOIN tblWork w  " & _
			 "ON d.parent_job_order_id = w.Number2 AND d.organization_id = w.Number1  "
			dbS.NonQuery(sSQL)
			'also post item fixed lead time in case we can't find a job for this demand  'override to 7 days lead time!  lead times are messed up ***
			sSQL = "UPDATE d SET usingAssemblyLeadTime = i.fixed_lead_time FROM mrp_demand d  INNER JOIN active_items i  " & _
			 "ON d.using_assembly_item_id = i.inventory_item_id AND d.organization_id = i.organization_id  " & _
			 "WHERE d.using_assembly_item_id <> d.inventory_item_id"
			dbS.NonQuery(sSQL)
			createLoggingStamp("PrepareToCalculateShortages")

			'POST SALES ORDER INFO TO MRP DEMAND
			'match on Org, Sales Order Header, Project
			sSQL = "UPDATE s SET s.DEMAND_ID = d.DEMAND_ID  FROM sales_orders s INNER JOIN mrp_demand d  " & _
			 "ON s.ORDER_NO = d.PARENT_SALES_ORDER_NO  AND s.PROJECT_ID = d.PROJECT_ID  AND s.ORGANIZATION_ID = d.ORGANIZATION_ID AND s.INVENTORY_ITEM_ID = d.INVENTORY_ITEM_ID " & _
			 "WHERE d.PARENT_SALES_ORDER_NO IS NOT NULL AND s.SCHEDULE_SHIP_DATE = d.MRP_DATE AND s.ORDERED_QUANTITY = d.MRP_QTY"

			dbS.NonQuery(sSQL)
			'match non-project sales orders on item, org, date, order header
            sSQL = "UPDATE s SET s.DEMAND_ID = d.DEMAND_ID   FROM sales_orders s  INNER JOIN mrp_demand d " & _
             "ON s.ORDER_NO = d.PARENT_SALES_ORDER_NO AND s.INVENTORY_ITEM_ID = d.INVENTORY_ITEM_ID  AND s.ORGANIZATION_ID = d.ORGANIZATION_ID  " & _
             "WHERE d.PARENT_SALES_ORDER_NO IS NOT NULL AND s.DEMAND_ID IS NULL  AND s.SCHEDULE_SHIP_DATE = d.MRP_DATE AND s.ORDERED_QUANTITY = d.MRP_QTY "
			dbS.NonQuery(sSQL)
			'this will leave some stragglers, match them up if the dates aren't too far apart
            sSQL = "UPDATE s SET s.DEMAND_ID = d.DEMAND_ID  FROM sales_orders s  INNER JOIN mrp_demand d " & _
             "ON s.ORDER_NO = d.PARENT_SALES_ORDER_NO AND s.INVENTORY_ITEM_ID = d.INVENTORY_ITEM_ID  AND s.ORGANIZATION_ID = d.ORGANIZATION_ID  " & _
             "WHERE d.PARENT_SALES_ORDER_NO IS NOT NULL AND s.DEMAND_ID IS NULL AND Abs(CONVERT(float,s.SCHEDULE_SHIP_DATE) - CONVERT(float,d.MRP_DATE)) < 720 "
			dbS.NonQuery(sSQL)
			'update the MRP Demand table to show which demands are "top level" - i.e. from sales orders
			sSQL = "UPDATE d SET END_DEMAND_ID = s.DEMAND_ID, LEVEL_NO = 0, neededBy = d.MRP_DATE, PARENT_SALES_ORDER_ID = s.HEADER_ID, PARENT_SALES_ORDER_LINE = s.LINE_NO  " & _
			 "FROM mrp_demand d  INNER JOIN sales_orders s  " & _
			 "ON d.DEMAND_ID = s.DEMAND_ID AND d.INVENTORY_ITEM_ID = s.INVENTORY_ITEM_ID AND d.ORGANIZATION_ID = s.ORGANIZATION_ID  " & _
			 "WHERE s.DEMAND_ID IS NOT NULL "
			dbS.NonQuery(sSQL)
			createLoggingStamp("PrepareToCalculateShortages")

			'SEPARATE PROJECT (Seiban) INVENTORY:
			'start by using the wip bom DFF (attribute2 = Seiban_Controlled) to indicate every MRP Demand that is truly a seiban demand for a job.  the reason some of it is not valid is that we have a customization in Oracle BOM & WIP (bills) where the DFF (attribute2) determines if that particular component is seiban controlled, but MRP does not recognize that!
			dbS.NonQuery("DELETE FROM tblWork")
			sSQL = "INSERT INTO tblWork (Number1, Number2, Number3, Text1)  SELECT  d.ORGANIZATION_ID, d.DEMAND_ID, d.PROJECT_ID, 'job'  " & _
			 "FROM dbo.open_boms AS b INNER JOIN dbo.mrp_demand AS d  " & _
			 "ON b.ORGANIZATION_ID = d.ORGANIZATION_ID AND b.WIP_ENTITY_ID = d.PARENT_JOB_ORDER_ID AND b.INVENTORY_ITEM_ID = d.INVENTORY_ITEM_ID AND b.PROJECT_ID = d.PROJECT_ID  " & _
			 "WHERE b.SEIBAN_CONTROLLED LIKE 'Y%'"
			dbS.NonQuery(sSQL)
			'also find demands that are directly from a seiban sales order
			sSQL = "INSERT INTO tblWork (Number1, Number2, Number3, Text1)  SELECT  d.ORGANIZATION_ID, d.DEMAND_ID, d.PROJECT_ID, 'so'  " & _
			 "FROM dbo.sales_orders AS s INNER JOIN dbo.mrp_demand AS d  " & _
			 "ON s.ORGANIZATION_ID = d.ORGANIZATION_ID AND s.ORDER_NO = d.PARENT_SALES_ORDER_NO AND s.INVENTORY_ITEM_ID = d.INVENTORY_ITEM_ID AND s.PROJECT_ID = d.PROJECT_ID  "
			dbS.NonQuery(sSQL)
			'pick up any lower level components that are seiban controlled by looking at PO's with same project # and org-item as MRP Demand project info.  usually these are the purchased castings of a seiban machined casting
			sSQL = "INSERT INTO tblWork (Number1, Number2, Number3, Text1)  SELECT d.ORGANIZATION_ID, d.DEMAND_ID, d.PROJECT_ID, 'lower purch'  " & _
			 "FROM dbo.PO AS p  INNER JOIN dbo.mrp_demand AS d  " & _
			 "ON p.SHIP_TO_ORGANIZATION_ID = d.ORGANIZATION_ID AND p.INVENTORY_ITEM_ID = d.INVENTORY_ITEM_ID And p.PROJECT_ID = d.PROJECT_ID  "
			dbS.NonQuery(sSQL)
			'also check for lower level mfg parts
			sSQL = "INSERT INTO tblWork (Number1, Number2, Number3, Text1)  SELECT d.ORGANIZATION_ID, d.DEMAND_ID, d.PROJECT_ID, 'lower mfg'  " & _
			 "FROM dbo.mrp_demand AS d  INNER JOIN dbo.jobs AS j   " & _
			 "ON d.ORGANIZATION_ID = j.ORGANIZATION_ID AND d.INVENTORY_ITEM_ID = j.INVENTORY_ITEM_ID And d.PROJECT_ID = j.PROJECT_ID  " & _
			 "GROUP BY d.ORGANIZATION_ID, d.DEMAND_ID, d.PROJECT_ID "
			dbS.NonQuery(sSQL)
			'erase all project info from MRP Demand, then put back in only the valid project references.  this solves the problem of Oracle MRP not recognizing which parts are truly seiban controlled and which are not!  
            dbS.NonQuery("UPDATE a SET a.project_ID = NULL, a.QTY_ONHAND = 0 FROM mrp_demand a LEFT OUTER JOIN items b ON a.organization_id = b.organization_id AND a.inventory_item_id = b.inventory_item_id WHERE b.end_assembly_pegging_flag NOT IN ('X','I') ")        'Keep the project information because we just want to use the dff flexfield for soft pegged items 'project change
            'Find out the soft pegged items. Only keep the ones that are truly hard pegged!
            dbS.NonQuery("UPDATE mrp_demand SET QTY_ONHAND = 0")                          ' do not forget to switch this back in order to - needs to be done because the statement above does not touch everything


            sSQL = "UPDATE d SET project_ID = w.Number3 FROM dbo.mrp_demand AS d INNER JOIN dbo.tblWork AS w " & _
                 "ON d.ORGANIZATION_ID = w.Number1 AND d.DEMAND_ID = w.Number2"
            dbS.NonQuery(sSQL)
			createLoggingStamp("PrepareToCalculateShortages")

			'POST project On Hand Inventory to MRP Demand, Sales Orders, Jobs and PO's
			'these are the four tables that need the on hand qty updated, segregated by Seiban 
			sTable(0) = "mrp_demand"
			sTable(1) = "sales_orders"
			sTable(2) = "jobs"
			sTable(3) = "po"
			sTmp = "organization_id"
			For x = LBound(sTable) To UBound(sTable)
				If x = UBound(sTable) Then sTmp = "ship_to_organization_id"
				'POST Project On Hand Inventory to each MRP Demand....                    *** will break if site uses multiple uoms for same item
				sSQL = "UPDATE d SET QTY_ONHAND = q.QTY_ONHAND FROM dbo." & sTable(x) & " AS d  INNER JOIN dbo.items_qty_oh AS q  " & _
				 "ON q.ORGANIZATION_ID = d." & sTmp & " AND q.INVENTORY_ITEM_ID = d.INVENTORY_ITEM_ID AND q.PROJECT_ID = d.PROJECT_ID  " & _
				 "WHERE d.PROJECT_ID IS NOT NULL "
				dbS.NonQuery(sSQL)
				'...and the non-project inventory to all non-project demand
                sSQL = "UPDATE d SET QTY_ONHAND = q.QTY_ONHAND FROM dbo." & sTable(x) & "  AS d  INNER JOIN dbo.items_qty_oh AS q  " & _
                 "ON q.ORGANIZATION_ID = d." & sTmp & "  AND q.INVENTORY_ITEM_ID = d.INVENTORY_ITEM_ID " & _
                 "WHERE d.PROJECT_ID IS NULL AND q.PROJECT_ID IS NULL "                                                                     '*** need to do this only for the hard pegged items
				dbS.NonQuery(sSQL)
			Next

			'now that we are finished determining how long each job takes, we can delete all completed jobs that don't have any mrp demand.    if there is demand, we need TO OPEN UP THE LAST OP (say ISSUE MATERIAL) ***
			dbS.NonQuery("UPDATE jobs SET temp = NULL")
			dbS.NonQuery("UPDATE j SET temp = 'temp' FROM jobs j INNER JOIN mrp_demand d  ON j.organization_id = d.organization_id AND j.wip_entity_id = d.parent_job_order_id")
			dbS.NonQuery("DELETE FROM jobs WHERE temp IS NULL and STATUS_TYPE NOT IN (1,3,6)")

			'BEGIN PROCESS OF CALCULATING TRUE 'NEED BY' DATES
			'show which jobs and po's will fulfill the sales orders.  first match jobs, that have lower level demand
			sSQL = "UPDATE d SET job_no = j.job_no, job_id = j.wip_entity_id, status = j.status_type, start_quantity_hdr = j.start_quantity_hdr  FROM mrp_demand d  INNER JOIN jobs j  " & _
			  "ON d.ORGANIZATION_ID = j.ORGANIZATION_ID AND d.INVENTORY_ITEM_ID = j.INVENTORY_ITEM_ID AND d.PROJECT_ID = j.PROJECT_ID  " & _
			  "WHERE j.temp IS NOT NULL "
			dbS.NonQuery(sSQL)
			'2nd match jobs that have no lower level demand  most of these are probably seiban jobs that mrp wants to cancel
			sSQL = "UPDATE d SET job_no = j.job_no, job_id = j.wip_entity_id, status = j.status_type, start_quantity_hdr = j.start_quantity_hdr  FROM mrp_demand d  INNER JOIN jobs j  " & _
			 "ON d.ORGANIZATION_ID = j.ORGANIZATION_ID AND d.INVENTORY_ITEM_ID = j.INVENTORY_ITEM_ID AND d.PROJECT_ID = j.PROJECT_ID  " & _
			 "WHERE d.job_id IS NULL "
			dbS.NonQuery(sSQL)
			'3rd match PO's
			sSQL = "UPDATE d SET purchase_order_id = p.PO_HEADER_ID, purchase_order_no = p.PO_NO, purch_line_no = p.LINE_NO, qty_open = (p.QUANTITY_ORDERED - p.QTY_RECEIVED), source_vendor_id = p.VENDOR_ID, vendor_name = p.VENDOR_NAME  " & _
			  "FROM dbo.mrp_demand d  INNER JOIN dbo.PO p  ON d.INVENTORY_ITEM_ID = p.INVENTORY_ITEM_ID AND d.PROJECT_ID = p.PROJECT_ID AND d.ORGANIZATION_ID = p.SHIP_TO_ORGANIZATION_ID  "
			dbS.NonQuery(sSQL)
			'copy any 'freebie' end-demand-id's we get, because the project numbers match
			sSQL = "UPDATE d set end_demand_id = d2.end_demand_id, level_no = d2.level_no +1 FROM mrp_demand d  INNER JOIN mrp_demand d2  ON d.organization_id = d2.organization_id AND d.project_id = d2.project_id " & _
			 "WHERE d.end_demand_id IS NULL  AND d2.end_demand_id IS NOT NULL"
			dbS.NonQuery(sSQL)
			createLoggingStamp("PrepareToCalculateShortages")

			'set the Need By date for lower level demand, because the top level job is scheduled differently than the sales order scheduled ship date  
			sSQL = "UPDATE d SET level_no = 1, end_demand_id = d2.end_demand_id, neededBy = DATEADD(d, - d.parentJobOrderLeadTime, d2.neededBy)  FROM mrp_demand d  INNER JOIN mrp_demand d2  " & _
			  "ON d.parent_job_order_id = d2.job_id AND d.organization_id = d2.organization_id   WHERE d2.level_no = 0"
			dbS.NonQuery(sSQL)

			'for project demand with no Parent Job, set the Need By date based on the linked project sales order.  this is only necessary because Chpk is using soft pegging so MRP doesn't link them properly   
			sSQL = "UPDATE d  SET neededBy = DATEADD(d, - d.usingAssemblyLeadTime, d2.neededBy)  FROM mrp_demand AS d  INNER JOIN mrp_demand AS d2 " & _
			 "ON d.USING_ASSEMBLY_ITEM_ID = d2.INVENTORY_ITEM_ID AND d.PROJECT_ID = d2.PROJECT_ID AND d.END_DEMAND_ID = d2.END_DEMAND_ID AND d.ORGANIZATION_ID = d2.ORGANIZATION_ID " & _
			 "WHERE d2.LEVEL_NO = 0 AND d.LEVEL_NO = 1 AND d.neededBy IS NULL AND d.PARENT_PLANNED_ORDER_ID IS NOT NULL"
			dbS.NonQuery(sSQL)

			dbS.NonQuery("UPDATE d SET neededBy = DATEADD(d,-2,neededBy) FROM mrp_demand d WHERE DATEPART(dw,neededBy) = 1")	'change Sunday to prior Friday
			dbS.NonQuery("UPDATE d SET neededBy = DATEADD(d,-1,neededBy) FROM mrp_demand d WHERE DATEPART(dw,neededBy) = 7")	'change Saturday to prior Friday

			'for second level down, correct the MRP date by matching parent item & seiban jobs to child.   *** &&& why are we only doing two levels here?  HMB might need 5!
			sSQL = "UPDATE d SET level_no = 2, end_demand_id = d2.end_demand_id, neededBy = DATEADD(d, - d.parentJobOrderLeadTime, d2.neededBy)  " & _
			 "FROM dbo.mrp_demand d  INNER JOIN dbo.mrp_demand d2  ON d.ORGANIZATION_ID = d2.ORGANIZATION_ID AND d.PARENT_JOB_ORDER_ID = d2.JOB_ID " & _
			 "WHERE d.LEVEL_NO IS NULL AND d2.LEVEL_NO = 1"
			dbS.NonQuery(sSQL)
			dbS.NonQuery("UPDATE d SET neededBy = DATEADD(d,-2,neededBy) FROM mrp_demand d WHERE DATEPART(dw,neededBy) = 1")	'change Sunday to prior Friday duplicated
			dbS.NonQuery("UPDATE d SET neededBy = DATEADD(d,-1,neededBy) FROM mrp_demand d WHERE DATEPART(dw,neededBy) = 7")	'change Saturday to prior Friday duplicated
			createLoggingStamp("PrepareToCalculateShortages")

            'Added the next levels: +++++ Change to apply for more levels
            'Level 3
            sSQL = "UPDATE d SET level_no = 3, end_demand_id = d2.end_demand_id, neededBy = DATEADD(d, - d.parentJobOrderLeadTime, d2.neededBy)  " & _
                "FROM dbo.mrp_demand d  INNER JOIN dbo.mrp_demand d2  ON d.ORGANIZATION_ID = d2.ORGANIZATION_ID AND d.PARENT_JOB_ORDER_ID = d2.JOB_ID " & _
                "WHERE d.LEVEL_NO IS NULL AND d2.LEVEL_NO = 2"
            dbS.NonQuery(sSQL)
            
            createLoggingStamp("PrepareToCalculateShortages")

            'Level 4
            sSQL = "UPDATE d SET level_no = 4, end_demand_id = d2.end_demand_id, neededBy = DATEADD(d, - d.parentJobOrderLeadTime, d2.neededBy)  " & _
                       "FROM dbo.mrp_demand d  INNER JOIN dbo.mrp_demand d2  ON d.ORGANIZATION_ID = d2.ORGANIZATION_ID AND d.PARENT_JOB_ORDER_ID = d2.JOB_ID " & _
                       "WHERE d.LEVEL_NO IS NULL AND d2.LEVEL_NO = 3"
            dbS.NonQuery(sSQL)

            'Level 5
            sSQL = "UPDATE d SET level_no = 5, end_demand_id = d2.end_demand_id, neededBy = DATEADD(d, - d.parentJobOrderLeadTime, d2.neededBy)  " & _
                    "FROM dbo.mrp_demand d  INNER JOIN dbo.mrp_demand d2  ON d.ORGANIZATION_ID = d2.ORGANIZATION_ID AND d.PARENT_JOB_ORDER_ID = d2.JOB_ID " & _
                    "WHERE d.LEVEL_NO IS NULL AND d2.LEVEL_NO = 4"
            dbS.NonQuery(sSQL)

            dbS.NonQuery("UPDATE d SET neededBy = DATEADD(d,-2,neededBy) FROM mrp_demand d WHERE DATEPART(dw,neededBy) = 1")    'change Sunday to prior Friday duplicated
            dbS.NonQuery("UPDATE d SET neededBy = DATEADD(d,-1,neededBy) FROM mrp_demand d WHERE DATEPART(dw,neededBy) = 7")    'change Saturday to prior Friday duplicated
            createLoggingStamp("PrepareToCalculateShortages")

		Catch ex As Exception
			createErrorLog("PrepareToCalculateShortages", ex)
		Finally
			dbS.Disconnect()
		End Try

	End Sub



	'finish linking supply and demand, and calculate shortages  - rewrite rh Sep2010 - most of this procedure can be removed if Chpk creates a duplicate set of CM part numbers, hard pegged
	Public Sub CalculateShortages()
		Try

			Dim sTmp As String = ""
			Dim sSQL As String
			Dim sItemProj As String = ""
			Dim sItemProjPrev As String = ""
			Dim dblNetShort As Double
			Dim dblShortPrev As Double
			Dim dblSupply As Double
			Dim x As Integer
			Dim y As Integer
			Dim dblQtyOnHand As Double
			Dim dsS As New DataSet

			'Connect to the database
			dbS.Connect()
			createLoggingStamp("CalculateShortages")

			'identify parts where true need by date is indeterminate.  assign the jobs to fulfill demand that we can, in order to determine true need by date
			dbS.NonQuery("UPDATE mrp_demand SET temp = NULL")
			dbS.NonQuery("DELETE FROM tblWork")
			dbS.NonQuery("INSERT INTO tblWork (Number1, Number2) SELECT organization_id, inventory_item_id FROM mrp_demand WHERE end_demand_id IS NULL GROUP BY organization_id, inventory_item_id")
			dbS.NonQuery("UPDATE d SET temp = 'missing end-demand' FROM mrp_demand d  INNER JOIN tblWork w  ON d.organization_id = w.Number1 AND d.inventory_item_id = w.Number2 ")

			For y = 0 To 2

				'link non-project, orphaned demand to parent end demand.  since there is no parent job, use planned order to link.  &&& THIS PROCESS incorrectly matches lower level castings to sales order, if there is a planned order inbetween the casting and the sales order. example 	'looking for 95935699   need to trace it by hand and ascertain how to peg correctly!
                For x = 0 To 3
                    sSQL = "UPDATE d SET END_DEMAND_ID = d1.END_DEMAND_ID, LEVEL_NO =  d1.LEVEL_NO + 1, neededBy = DATEADD(d, - d.usingAssemblyLeadTime, d1.neededBy)  " & _
                      "FROM dbo.mrp_demand d  INNER JOIN dbo.mrp_supply s  ON d.ORGANIZATION_ID = s.ORGANIZATION_ID AND d.PARENT_PLANNED_ORDER_ID = s.PLANNED_ORDER_ID  " & _
                      "INNER JOIN dbo.mrp_demand d1 ON s.DEMAND_ID = d1.DEMAND_ID AND s.ORGANIZATION_ID = d1.ORGANIZATION_ID " & _
                      "WHERE d1.END_DEMAND_ID IS NOT NULL  AND  d.END_DEMAND_ID IS NULL  AND  d.PROJECT_ID IS NULL "
                    dbS.NonQuery(sSQL)
                    'Does not use the pegging information to run down the tree!
                Next x

                If runningInst = "/test" Then
                    'Maps down the pegging tree 
                    For x = 0 To 9
                        sSQL = " UPDATE mrp_demand_1 SET end_demand_id = dbo.mrp_demand.END_DEMAND_ID, level_no = ISNULL(dbo.mrp_demand.level_no,1) + 1 " & _
                                " FROM         dbo.mrp_demand INNER JOIN " & _
                                "                      dbo.mrp_supply ON dbo.mrp_demand.ORGANIZATION_ID = dbo.mrp_supply.ORGANIZATION_ID AND  " & _
                                "                      dbo.mrp_demand.DEMAND_ID = dbo.mrp_supply.DEMAND_ID INNER JOIN  " & _
                                "                      dbo.mrp_supply AS mrp_supply_1 ON dbo.mrp_supply.PEGGING_ID = mrp_supply_1.PREV_PEGGING_ID AND  " & _
                                "                      dbo.mrp_supply.ORGANIZATION_ID = mrp_supply_1.ORGANIZATION_ID INNER JOIN  " & _
                                "                      dbo.mrp_demand AS mrp_demand_1 ON mrp_supply_1.ORGANIZATION_ID = mrp_demand_1.ORGANIZATION_ID AND  " & _
                                "                    mrp_supply_1.DEMAND_ID = mrp_demand_1.DEMAND_ID  " & _
                                " WHERE     (dbo.mrp_demand.END_DEMAND_ID IS NOT NULL) AND (mrp_demand_1.END_DEMAND_ID IS NULL) "
                        dbS.NonQuery(sSQL)
                    Next x
                End If

                'set the allocation priority date to the lesser of  MRP Date or the calculated Need By Date.  
                If y = 0 Then sTmp = "AND temp IS NULL "
                If y = 1 Then sTmp = " AND temp IS NOT NULL "
                If y = 2 Then
                    sTmp = " "
                    dbS.NonQuery("UPDATE mrp_demand SET purchase_order_id = NULL, purch_line_no = NULL, job_id = NULL, short = NULL")
                End If
                dbS.NonQuery("UPDATE d SET consumptionPriorityDate = NULL FROM mrp_demand d WHERE demand_id IS NOT NULL " & sTmp)
                dbS.NonQuery("UPDATE d SET consumptionPriorityDate = neededBy FROM mrp_demand d WHERE neededBY IS NOT NULL " & sTmp)
                dbS.NonQuery("UPDATE d SET consumptionPriorityDate = MRP_DATE FROM mrp_demand d WHERE consumptionPriorityDate IS NULL " & sTmp)

                'CALCULATE QTY SHORT for each item-project
                'Open MRP demand table sorted by org, item, project and consumption priority 
                sSQL = "SELECT * FROM MRP_DEMAND  WHERE demand_id IS NOT NULL " & sTmp & " ORDER BY ORGANIZATION_ID, INVENTORY_ITEM_ID, PROJECT_ID, consumptionPriorityDate, MRP_QTY"
                Dim conn As New SqlClient.SqlConnection(My.Settings("FLOWConnectionString"))
                Dim adp As New SqlClient.SqlDataAdapter(sSQL, conn)
                Dim cb As New SqlClient.SqlCommandBuilder(adp)
                Dim dt As New DataTable
                adp.Fill(dt)

                'cycle through each demand, and calculate if the part has any net shortages
                If dt.Rows.Count > 0 Then
                    For Each Row As DataRow In dt.Rows
                        sItemProj = Row("ORGANIZATION_ID").ToString & Row("INVENTORY_ITEM_ID").ToString & Row("PROJECT_ID").ToString
                        If sItemProj <> sItemProjPrev Then 'If new item number, reset variables
                            sItemProjPrev = sItemProj
                            If DBNull.Value.Equals(Row("QTY_ONHAND")) Then
                                dblQtyOnHand = 0
                            Else
                                dblQtyOnHand = Row("QTY_ONHAND")
                            End If
                        End If
                        dblQtyOnHand -= Row("MRP_QTY") 'subtract MRP needed qty from qty on hand
                        'if we are short, update the MRP Demand table
                        'Here we do run into buffer overrun
                        If dblQtyOnHand < 0 Then
                            Row("Short") = -dblQtyOnHand
                        End If
                    Next
                    adp.Update(dt) ' Send the changes made in the datatable back to the database.  this will not work unless the table has a primary key defined.  i used demand_id for MRP Demand
                End If
                adp.Dispose()
                dt.Dispose()

                'STAGE ALL SUPPLY 
                dbS.NonQuery("DELETE FROM tblWork")
                'make temporary supply table that blends jobs and po's together.  this is so that supply can be pegged correctly even when it is simultaneously purchased and made in house.
                '                                                 org          item id       job ID     project       qty        due    job_no  start  status   duration
                sSQL = "INSERT INTO tblWork (Number1, Number2, Number3, Number6, Number7, Date1, Text1, Date2, Text2, Number8)  " & _
                  "SELECT ORGANIZATION_ID, INVENTORY_ITEM_ID, WIP_ENTITY_ID, MAX(PROJECT_ID), MAX(START_QUANTITY_HDR - QUANTITY_COMPLETED_HDR - QUANTITY_SCRAPPED_HDR), MAX(COMPLETION_DATE),  " & _
                  "MIN(JOB_NO), MIN(FIRST_UNIT_START_DATE), MIN(MEANING), CONVERT(integer,MAX(LAST_UNIT_COMPLETION_DATE) - MIN(FIRST_UNIT_START_DATE))  " & _
                  "FROM dbO.jobs GROUP BY ORGANIZATION_ID, INVENTORY_ITEM_ID, WIP_ENTITY_ID "
                dbS.NonQuery(sSQL)
                '                                                 org           item id      po           line       shipment    project       qty        due           release_number
                sSQL = "INSERT INTO tblWork (Number1, Number2, Number3, Number4, Number5, Number6, Number7, Date1, Number8)  " & _
                 "SELECT SHIP_TO_ORGANIZATION_ID, INVENTORY_ITEM_ID, PO_HEADER_ID, LINE_NO, SHIPMENT_NO, PROJECT_ID, QUANTITY_ORDERED - QTY_RECEIVED AS QTY_OPEN, NEED_BY_DATE, RELEASE_NO  " & _
                 "FROM dbO.PO "
                dbS.NonQuery(sSQL)

                'Link each MRP shortage to a replenishment, start by opening the demand table selecting net shortages only for this level
                Dim adpMRPDemand As New SqlClient.SqlDataAdapter("SELECT * FROM MRP_DEMAND  WHERE SHORT IS NOT NULL  ORDER BY ORGANIZATION_ID, INVENTORY_ITEM_ID, PROJECT_ID, SHORT", conn)
                Dim cbMRPDemand As New SqlClient.SqlCommandBuilder(adpMRPDemand)
                Dim dtMRPDemand As New DataTable
                adpMRPDemand.Fill(dtMRPDemand)

                'cycle through each net shortage
                If dtMRPDemand.Rows.Count > 0 Then
                    For Each rowMRPDemand As DataRow In dtMRPDemand.Rows
                        sItemProj = rowMRPDemand("ORGANIZATION_ID") & rowMRPDemand("INVENTORY_ITEM_ID") & rowMRPDemand("PROJECT_ID")
                        If sItemProj <> sItemProjPrev Then 'If new org-item-project, reset variables
                            sItemProjPrev = sItemProj
                            'get a list of all upcoming supplies for this org-item-project.  get each job, qty, end date   and   PO-line, qty, req-date. 
                            sSQL = "SELECT Number1, Number2, Number3, Number4, Number5, Number6, Number7, Date1, Number8  " & _
                             "FROM dbo.tblWork  WHERE Number1 = " & rowMRPDemand("ORGANIZATION_ID") & " AND Number2 = " & rowMRPDemand("INVENTORY_ITEM_ID") & "  AND Number7 > 0  "
                            If Not DBNull.Value.Equals(rowMRPDemand("PROJECT_ID")) Then sSQL += " AND Number6 = " & rowMRPDemand("PROJECT_ID") & "  " Else sSQL += " AND Number6 IS NULL  "
                            sSQL += "ORDER BY Date1 "
                            dsS = dbS.Query(sSQL)
                            dblSupply = 0
                            dblShortPrev = 0
                            x = -1
                        End If

                        dblNetShort = rowMRPDemand("SHORT") - dblShortPrev  'set initial shortage amount
                        If dsS.Tables(0).Rows.Count > 0 Then                'if there is any supply to be had 
                            If dblSupply < dblNetShort Then
                                Do Until x >= dsS.Tables(0).Rows.Count - 1 'keep adding supply until we have enough to fill the demand
                                    x += 1
                                    dblSupply += dsS.Tables(0).Rows(x).Item("Number7")  'add the supply qty 
                                    If dblSupply >= dblNetShort Then Exit Do
                                Loop
                            End If

                            'mark the demand record with the supply that will fill it
                            If dblSupply > 0 Then
                                If Not DBNull.Value.Equals(dsS.Tables(0).Rows(x).Item("Number4")) Then   'the supply is a PO            ***po need to post the shipment and release number
                                    rowMRPDemand("Purchase_Order_ID") = dsS.Tables(0).Rows(x).Item("Number3")
                                    rowMRPDemand("Purch_Line_No") = dsS.Tables(0).Rows(x).Item("Number4")
                                    rowMRPDemand("RELEASE_NO") = dsS.Tables(0).Rows(x).Item("Number8")
                                    rowMRPDemand("SHIPMENT_NO") = dsS.Tables(0).Rows(x).Item("Number5")
                                Else    'the supply is a job
                                    rowMRPDemand("Job_ID") = dsS.Tables(0).Rows(x).Item("Number3")
                                End If
                                dblSupply -= dblNetShort 'subtract the demand filled from existing supply
                            End If
                        End If

                        dblShortPrev = rowMRPDemand("SHORT") 'remember the cumulative short qty so we can subtract it from next record to get next net shortage amount

                    Next

                    createLoggingStamp("CalculateShortages")
                    adpMRPDemand.Update(dtMRPDemand)     'update the MRP Demand table
                    createLoggingStamp("CalculateShortages")
                End If

                dtMRPDemand.Dispose()
                adpMRPDemand.Dispose()
                conn.Dispose()

                For x = 0 To 2
                    'fix mrp dates for lower level demand, because the top level job is scheduled differently than the sales order scheduled ship date 
                    sSQL = "UPDATE d SET level_no = d2.level_no + 1, end_demand_id = d2.end_demand_id, neededBy = DATEADD(d, - d.parentJobOrderLeadTime, d2.neededBy)  FROM mrp_demand d  INNER JOIN mrp_demand d2  " & _
                     "ON d.parent_job_order_id = d2.job_id AND d.organization_id = d2.organization_id  WHERE d.neededBy IS NULL "
                    dbS.NonQuery(sSQL)
                    dbS.NonQuery("UPDATE d SET neededBy = DATEADD(d,-2,neededBy) FROM mrp_demand d WHERE DATEPART(dw,neededBy) = 1")    'change Sunday to prior Friday
                    dbS.NonQuery("UPDATE d SET neededBy = DATEADD(d,-1,neededBy) FROM mrp_demand d WHERE DATEPART(dw,neededBy) = 7")    'change Saturday to prior Friday
                Next x

            Next y

			'fill in additional PO fields on MRP Demand table 
            sSQL = "UPDATE d SET Source_Vendor_ID = p.Vendor_ID, Vendor_Name = p.Vendor_Name, Purchase_Order_No = p.PO_NO, Qty_Open = (p.Quantity_Ordered - p.Qty_Received), PO_Promised_Date = p.Promised_Date " & _
              "FROM dbo.mrp_demand AS d  INNER JOIN dbo.PO AS p  " & _
              "ON p.SHIP_TO_ORGANIZATION_ID = d.ORGANIZATION_ID AND p.PO_HEADER_ID = d.PURCHASE_ORDER_ID And p.LINE_NO = d.PURCH_LINE_NO "              '***po need to join also on release number and shipment number
			dbS.NonQuery(sSQL)

			'fill in additional Job fields on MRP Demand table  
			sSQL = "UPDATE d SET JOB_NO = w.Text1, START_QUANTITY_HDR = w.Number7, START_DATE = w.Date2, STATUS =w.Text2, jobDuration = w.Number8  " & _
			 "FROM dbo.mrp_demand d  INNER JOIN dbo.tblWork w  " & _
			 "ON d.ORGANIZATION_ID = w.Number1 AND d.JOB_ID = w.Number3  "
			dbS.NonQuery(sSQL)

			createLoggingStamp("CalculateShortages")

		Catch ex As Exception
			createErrorLog("CalculateShortages", ex)
		Finally
			dbS.Disconnect()
		End Try

	End Sub

    ''' <summary>
    ''' Procedure that calculates the cumulative short quantity for an incremental refresh during the day.
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub recalculateCumulativeShort()
        Dim sTmp As String = ""
        Dim sSQL As String
        Dim sItemProj As String = ""
        Dim sItemProjPrev As String = ""
        Dim dblQtyOnHand As Double
        Dim dsS As New DataSet

        'Just gather the new imported items.
        db.NonQuery("INSERT ")

        'Take care about the data table adapter -> It will block the whole table

        'CALCULATE QTY SHORT for each item-project
        'Open MRP demand table sorted by org, item, project and consumption priority 
        sSQL = "SELECT * FROM MRP_DEMAND  WHERE demand_id IS NOT NULL " & sTmp & " ORDER BY ORGANIZATION_ID, INVENTORY_ITEM_ID, PROJECT_ID, consumptionPriorityDate, MRP_QTY"
        Dim conn As New SqlClient.SqlConnection(My.Settings("FLOWConnectionString"))
        Dim adp As New SqlClient.SqlDataAdapter(sSQL, conn)
        Dim cb As New SqlClient.SqlCommandBuilder(adp)
        Dim dt As New DataTable
        adp.Fill(dt)

        'cycle through each demand, and calculate if the part has any net shortages
        If dt.Rows.Count > 0 Then
            For Each Row As DataRow In dt.Rows
                sItemProj = Row("ORGANIZATION_ID").ToString & Row("INVENTORY_ITEM_ID").ToString & Row("PROJECT_ID").ToString
                If sItemProj <> sItemProjPrev Then 'If new item number, reset variables
                    sItemProjPrev = sItemProj
                    dblQtyOnHand = Row("QTY_ONHAND")
                End If
                dblQtyOnHand -= Row("MRP_QTY") 'subtract MRP needed qty from qty on hand
                'if we are short, update the MRP Demand table
                If dblQtyOnHand < 0 Then
                    'Here we can run into decimal exception issue - at least we assume so.
                    Row("Short") = -dblQtyOnHand
                End If
            Next
            adp.Update(dt) ' Send the changes made in the datatable back to the database.  this will not work unless the table has a primary key defined.  i used demand_id for MRP Demand
        End If
        adp.Dispose()
        dt.Dispose()
    End Sub

