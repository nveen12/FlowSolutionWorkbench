	'======================  not sure best place to put these validation routines  ==============================

	'check Oracle to make sure the pick releases occurred that were requested by the user
    Public Sub validatePickReleases(Optional ByVal planningInst As String = "MRP")
        Try


            Dim dsS As New DataSet 'sql server
            Dim dsO As New DataSet 'Oracle
            Dim dbS As New DB.ServerDB(My.Settings("FlowConnectionString"))
            Dim dbO As New DB.ORacleServerDB(My.Settings("OracleSTARConnectionString"))  'connect to Oracle database
            Dim sSql As String
            Dim lngTmp As Long
            Dim lngOrgID As Long
            Dim lngOrderNo As Long
            Dim soView As String = "saveSalesOrders"
            If planningInst = "ASCP" Then soView = "saveMSCSalesOrders"

            dbS.Connect()
            dbO.Connect()

            'make a list of all the pending pick release transactions
            sSql = "SELECT * FROM warehouseTransactions WHERE  transactionType = 'salesOrderLinesView' AND validatedDate IS NULL AND (validationAttempts IS NULL or validationAttempts < 20)"
            Dim conn As New SqlClient.SqlConnection(My.Settings("FLOWConnectionString"))
            Dim adp As New SqlClient.SqlDataAdapter(sSql, conn)
            Dim cb As New SqlClient.SqlCommandBuilder(adp)
            Dim dt As New DataTable
            adp.Fill(dt)

            If dt.Rows.Count > 0 Then
                For Each Row As DataRow In dt.Rows
                    Try

                        lngOrgID = Row("organizationID")
                        lngOrderNo = Row("headerId")
                        dbS.NonQuery("DELETE FROM work_table1")

                        'look in Oracle to see if the pick_status has been updated
                        sSql = "SELECT ooh.order_number order_no, ool.line_number line_no, ool.shipment_number shipment_no, wdd.last_update_date, wl.meaning pick_status " & _
                           "FROM oe_order_headers_all ooh, oe_order_lines_all ool, wsh_delivery_details wdd, wsh_lookups wl " & _
                           "WHERE ooh.header_id = ool.header_id AND ool.header_id = wdd.source_header_id AND ool.line_id = wdd.source_line_id AND wdd.released_status = wl.lookup_code " & _
                           "AND wl.lookup_type = 'PICK_STATUS'  AND ool.ship_from_org_id = " & lngOrgID & " AND ooh.order_number = " & lngOrderNo & " AND wdd.last_update_date > sysdate - 1"
                        dsO = dbO.Query(sSql)
                        'copy Oracle data into the sql server work table
                        For x = 0 To dsO.Tables(0).Rows.Count - 1   '                     order no       line no    shipment  last update  pick status                                                                                                                                        
                            dbS.SecureNonQueryParams("INSERT INTO [work_table1] ([Number1], [Number2], [Number3], [Date1], [Text1]) VALUES (@1, @2, @3, @4, @5)", _
                            dsO.Tables(0).Rows(x).Item("order_no"), dsO.Tables(0).Rows(x).Item("line_no"), dsO.Tables(0).Rows(x).Item("shipment_no"), dsO.Tables(0).Rows(x).Item("last_update_date"), dsO.Tables(0).Rows(x).Item("pick_status"))
                        Next x

                        'mark the records in the work table where where the header no, line no, shipment no, and org match, but the pick status is different.
                        sSql = "UPDATE w SET number4 = 1 FROM " & soView & " s  INNER JOIN  work_table1 w  " & _
                         "ON s.order_no = w.Number1 AND s.line_no = w.number2 AND s.shipment_no = w.number3  " & _
                         "WHERE s.organization_id = " & lngOrgID & " AND s.pick_status <> w.text1"
                        dbS.NonQuery(sSql)
                        'run same update query on the displayed table
                        'here we have to distinct between ASCP and MRP (saveSalesOrders)
                        sSql = "UPDATE s SET pick_status = w.Text1 FROM " & soView & " s  INNER JOIN  work_table1 w  " & _
                         "ON s.order_no = w.Number1 AND s.line_no = w.number2 AND s.shipment_no = w.number3  " & _
                         "WHERE s.organization_id = " & lngOrgID
                        dbS.NonQuery(sSql)

                        'update the transaction table to indicate success & number of verification attempts
                        If Not DBNull.Value.Equals(Row("validationAttempts")) Then lngTmp = Row("validationAttempts") + 1 Else lngTmp = 1
                        Row("validationAttempts") = lngTmp
                        dsS = dbS.Query("SELECT max(date1) date1 FROM work_table1 WHERE number4 =1")
                        If dsS.Tables(0).Rows.Count > 0 Then
                            If Not DBNull.Value.Equals(dsS.Tables(0).Rows(0).Item("date1")) Then Row("validatedDate") = dsS.Tables(0).Rows(0).Item("date1")
                        End If

                    Catch ex As Exception

                    End Try
                Next
                adp.Update(dt) ' Send the changes made in the datatable back to the database.  this will not work unless the table has a primary key defined.  i used demand_id for MRP Demand
            End If

            adp.Dispose()
            dt.Dispose()
            dbO.Disconnect()
            dbS.Disconnect()

        Catch ex As Exception
            createErrorLog("validatePickReleases", ex)
        End Try
    End Sub



	'Check Oracle to see if the requested Promise Date change has occurred 
    Public Sub validatePOPromiseDates(Optional ByVal planningInst As String = "MRP")
        Try


            Dim dsS As New DataSet 'sql server
            Dim dsO As New DataSet 'Oracle
            Dim dbS As New DB.ServerDB(My.Settings("FlowConnectionString"))
            Dim dbO As New DB.ORacleServerDB(My.Settings("OracleSTARConnectionString"))
            Dim sSql As String
            Dim sHeaderNo As String
            Dim lngTmp As Long
            Dim lngOrgID As Long
            Dim lngLineNo As Long
            Dim lngReleaseNo As Long
            Dim lngShipmentNo As Long
            Dim poView As String = "savePO"
            If planningInst = "ASCP" Then poView = "saveMSCPO"

            dbS.Connect()
            dbO.Connect()

            'remove duplicate update requests.  (two+ people changed the same promise date in same timer interval)
            sSql = "UPDATE t SET validatedDate = {fn NOW()}, validationAttempts = 0  FROM warehouseTransactions t INNER JOIN warehouseTransactions t2 " & _
               "ON t.organizationID = t2.organizationID AND t.headerNo = t2.headerNo AND t.lineID = t2.lineID AND t.releaseNumber = t2.releaseNumber AND t.shipmentNumber = t2.shipmentNumber AND t.transactionType = 'POQueueView' AND t2.transactionType = 'POQueueView'" & _
              "WHERE t.transactionID < t2.transactionID AND t.validatedDate IS NULL"
            dbS.NonQuery(sSql)

            'retrieve the list of all the pending PO promise updates
            sSql = "SELECT * FROM warehouseTransactions WHERE  transactionType = 'POQueueView' AND validatedDate IS NULL AND (validationAttempts IS NULL or validationAttempts < 20)"
            Dim conn As New SqlClient.SqlConnection(My.Settings("FLOWConnectionString"))
            Dim adp As New SqlClient.SqlDataAdapter(sSql, conn)
            Dim cb As New SqlClient.SqlCommandBuilder(adp)
            Dim dt As New DataTable
            adp.Fill(dt)

            'cycle through each request to see if it updated yet in Oracle
            If dt.Rows.Count > 0 Then
                For Each Row As DataRow In dt.Rows
                    Try


                        lngOrgID = Row("organizationID")
                        sHeaderNo = Row("headerNo")
                        lngLineNo = Row("lineID")
                        lngReleaseNo = Row("releaseNumber")
                        lngShipmentNo = Row("shipmentNumber")
                        sSql = "SELECT POH.segment1, NVL(PLOC.promised_date,sysdate) promised_date, PLOC.last_update_date  FROM PO_HEADERS_ALL poh, PO_LINES_ALL pol, PO_LINE_LOCATIONS_ALL ploc, PO_RELEASES_ALL prel " & _
                          "WHERE POH.org_id = POL.org_id AND POH.po_header_id = POL.po_header_id AND PLOC.po_line_id = POL.po_line_id AND PREL.po_release_id(+) = PLOC.po_release_id " & _
                          "AND PLOC.ship_to_organization_id = " & lngOrgID & " AND POH.segment1 LIKE '" & sHeaderNo & "' AND POL.line_num = " & lngLineNo & " AND PLOC.shipment_num = " & lngShipmentNo & " AND PLOC.last_update_date > sysdate - 1 "
                        If lngReleaseNo > 0 Then sSql += " AND PREL.release_num = " & lngReleaseNo
                        dsO = dbO.Query(sSql)
                        If Not DBNull.Value.Equals(Row("validationAttempts")) Then lngTmp = Row("validationAttempts") + 1 Else lngTmp = 1
                        Row("validationAttempts") = lngTmp 'record the number of times we've tried to confirm the change in Oracle
                        If dsO.Tables(0).Rows.Count > 0 Then
                            'update the transaction table to indicate status validating in Oracle
                            If dsO.Tables(0).Rows(0).Item("promised_date") = Row("newDate") Then
                                Row("validatedDate") = dsO.Tables(0).Rows(0).Item("last_update_date") 'indicate validation is successful
                                'update the displayed table so all viewers can see this new promise date

                                'Make sure our ingREleaseNo = 0 is now really null
                                If lngReleaseNo = 0 Then
                                    sSql = "UPDATE " & poView & " SET promised_date = '" & Format(dsO.Tables(0).Rows(0).Item("promised_date"), "ddMMMyyyy") & "'" & _
                                  " WHERE ship_to_organization_id = " & lngOrgID & " AND po_no LIKE '" & sHeaderNo & "' AND line_no = " & lngLineNo & _
                                  " AND shipment_no = " & lngShipmentNo & " AND release_no IS NULL "
                                Else
                                    sSql = "UPDATE " & poView & " SET promised_date = '" & Format(dsO.Tables(0).Rows(0).Item("promised_date"), "ddMMMyyyy") & "'" & _
                                   " WHERE ship_to_organization_id = " & lngOrgID & " AND po_no LIKE '" & sHeaderNo & "' AND line_no = " & lngLineNo & _
                                   " AND shipment_no = " & lngShipmentNo & " AND release_no = " & lngReleaseNo
                                End If
                                
                                dbS.NonQuery(sSql)

                                'update the po table in case the transaction takes place just before the big refresh
                                sSql = "UPDATE PO SET promised_date = '" & Format(dsO.Tables(0).Rows(0).Item("promised_date"), "ddMMMyyyy") & "'" & _
                                   " WHERE ship_to_organization_id = " & lngOrgID & " AND po_no LIKE '" & sHeaderNo & "' AND line_no = " & lngLineNo & _
                                   " AND shipment_no = " & lngShipmentNo & " AND release_no = " & lngReleaseNo
                                dbS.NonQuery(sSql)
                            End If
                        End If
                    Catch ex As Exception

                    End Try
                Next
                adp.Update(dt) 'send the changes to the warehouse Transactions table
            End If

            adp.Dispose()
            dt.Dispose()
            dbO.Disconnect()
            dbS.Disconnect()

        Catch ex As Exception
            createErrorLog("validatePOPromiseDates", ex)
        End Try


    End Sub



	'Check Oracle to see if the requested Job Start Date change has occurred 
    Public Sub validateJobStartDates(Optional ByVal planningInst As String = "MRP")
        Try
            Dim dsS As New DataSet 'sql server
            Dim dsO As New DataSet 'Oracle
            Dim dbS As New DB.ServerDB(My.Settings("FlowConnectionString"))
            Dim dbO As New DB.ORacleServerDB(My.Settings("OracleSTARConnectionString"))
            Dim sSql As String
            Dim lngOrgID As Long
            Dim sHeaderNo As String
            Dim lngSeqNo As Long
            Dim lngTmp As Long
            Dim x As Integer
            Dim jobView As String = "saveJobs"
            If planningInst = "ASCP" Then jobView = "saveMSCJobs"

            'Make sure we do distinct MRP and ASCP

            dbS.Connect()
            dbO.Connect()

            'remove duplicate update requests.  (two+ people changed the same job start date in same timer interval)
            sSql = "UPDATE t SET validatedDate = {fn NOW()}  FROM warehouseTransactions t INNER JOIN warehouseTransactions t2 " & _
             "ON t.organizationID = t2.organizationID AND t.headerNo = t2.headerNo AND t.transactionType = t2.transactionType  WHERE t.transactionType LIKE 'WIPQueueView'  AND t.transactionID < t2.transactionID AND t.validatedDate IS NULL"
            dbS.NonQuery(sSql)

            'retrieve the list of all the pending Job Start updates
            sSql = "SELECT * FROM warehouseTransactions WHERE  transactionType = 'WIPQueueView' AND validatedDate IS NULL AND (validationAttempts IS NULL or validationAttempts < 20)"
            Dim conn As New SqlClient.SqlConnection(My.Settings("FLOWConnectionString"))
            Dim adp As New SqlClient.SqlDataAdapter(sSql, conn)
            Dim cb As New SqlClient.SqlCommandBuilder(adp)
            Dim dt As New DataTable
            adp.Fill(dt)

            'cycle through each request to see if it updated yet in Oracle
            If dt.Rows.Count > 0 Then
                For Each Row As DataRow In dt.Rows
                    Try

                        lngOrgID = Row("organizationID")
                        sHeaderNo = Row("headerNo")
                        lngSeqNo = Row("lineID")

                        'read current job oper dates from Oracle
                        sSql = "SELECT WE.wip_entity_name, OPS.operation_seq_num, trunc(OPS.first_unit_start_date) start_date, trunc(OPS.last_unit_completion_date) end_date, OPS.last_update_date " & _
                          "FROM WIP_ENTITIES WE  INNER JOIN WIP_OPERATIONS  OPS  ON OPS.wip_entity_id = WE.wip_entity_id AND OPS.organization_id = WE.organization_id " & _
                          "WHERE WE.organization_id = " & lngOrgID & "  AND WE.wip_entity_name LIKE '" & sHeaderNo & "' ORDER BY OPS.operation_seq_num "
                        dsO = dbO.Query(sSql)
                        If Not DBNull.Value.Equals(Row("validationAttempts")) Then lngTmp = Row("validationAttempts") + 1 Else lngTmp = 1
                        Row("validationAttempts") = lngTmp 'record the number of times we've tried to confirm the change in Oracle
                        If dsO.Tables(0).Rows.Count > 0 Then
                            'update the AB transaction table to indicate status validated in Oracle
                            If dsO.Tables(0).Rows(0).Item("start_date") = Row("newDate") Then
                                Row("validatedDate") = dsO.Tables(0).Rows(0).Item("last_update_date") 'indicate validation is successful
                                'for each wip job Operation, update the matching displayed value in AB so users can see the new Oracle start dates  
                                For x = 0 To dsO.Tables(0).Rows.Count - 1
                                    'update the displayed table so all viewers can see the new job operation start and complete dates
                                    sSql = "UPDATE " & jobView & " SET first_unit_start_date = '" & Format(dsO.Tables(0).Rows(x).Item("start_date"), "ddMMMyyyy") & "', completion_date = '" & Format(dsO.Tables(0).Rows(x).Item("end_date"), "ddMMMyyyy") & "'  " & _
                                     "WHERE organization_id = " & lngOrgID & " AND job_no LIKE '" & sHeaderNo & "' AND operation_seq_no = " & dsO.Tables(0).Rows(x).Item("operation_seq_num")
                                    dbS.NonQuery(sSql)
                                    sSql = "UPDATE Jobs SET first_unit_start_date = '" & Format(dsO.Tables(0).Rows(x).Item("start_date"), "ddMMMyyyy") & "', completion_date = '" & Format(dsO.Tables(0).Rows(x).Item("end_date"), "ddMMMyyyy") & "'  " & _
                                    "WHERE organization_id = " & lngOrgID & " AND job_no LIKE '" & sHeaderNo & "' AND operation_seq_no = " & dsO.Tables(0).Rows(x).Item("operation_seq_num")
                                    dbS.NonQuery(sSql)
                                Next x
                            End If
                        End If
                    Catch ex As Exception

                    End Try
                Next
                adp.Update(dt) 'send the changes to the warehouse Transactions table
            End If

            adp.Dispose()
            dt.Dispose()
            dbO.Disconnect()
            dbS.Disconnect()

        Catch ex As Exception
            createErrorLog("validateJobStartDates", ex)
        End Try
    End Sub


    Private Sub sendFailureMessagesOnTransactions()

        Dim dsS As New DataSet 'sql server

        'Start with master detail in order to send one package and have an easier cycle
        'We do only go with the dbnull value to compare as we only want to check the current records and not the complete history
        'Initially we updated all the history of triggered transaction to 0.
        Dim dsCreators As DataSet = db.Query("SELECT DISTINCT(createdBy) createdBy,(SELECT eMail FROM warehouse_users wu WHERE wu.user_name = wt.createdby) eMail FROM warehouseTransactions wt WHERE    (wt.validationAttempts = 20) AND wt.eMailFailureSent  IS NULL ORDER BY createdBy")

        For Each rowCr As DataRow In dsCreators.Tables(0).Rows
            Dim sb As New StringBuilder

            Dim sSQL As String = "SELECT wt.*,(SELECT eMail FROM warehouse_users wu WHERE wu.user_name = wt.createdby) eMail FROM warehouseTransactions wt WHERE    (wt.validationAttempts = 20) AND wt.eMailFailureSent  IS NULL AND wt.createdBy = '" & rowCr.Item("createdBy") & "' "
            dsS = db.Query(sSQL)
            Dim createBy As String = ""
            Dim sb2 As New StringBuilder

            'Starting comments
            sb2.Append("<table border=""0"" cellpadding=""0"" style=""background: #6699FF; mso-cellspacing: 1.5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 0in 0in 0in"" Width = ""1000"" > ")
            sb2.Append("<tr><td colspan=2 style=""background: white; padding: .75pt .75pt .75pt .75pt""> Autobahn – Notification E-Mail - Update transaction failure</td></tr>")


            For Each row As DataRow In dsS.Tables(0).Rows

                Dim strComment As String = ""
                If Not DBNull.Value.Equals(row.Item("headerNo")) Then
                    strComment += " Header: " & row.Item("headerNo")
                End If

                If Not DBNull.Value.Equals(row.Item("headerID")) Then
                    strComment += " Header: " & row.Item("headerID")
                End If

                If Not DBNull.Value.Equals(row.Item("lineID")) Then
                    strComment += " Line: " & row.Item("lineID")
                End If

                If Not DBNull.Value.Equals(row.Item("releaseNumber")) Then
                    strComment += " Release: " & row.Item("releaseNumber")
                End If

                If Not DBNull.Value.Equals(row.Item("shipmentNumber")) Then
                    strComment += " Shipment: " & row.Item("shipmentNumber")
                End If

                If Not DBNull.Value.Equals(row.Item("oldDate")) Then
                    strComment += " Old Date: " & row.Item("oldDate")
                End If

                If Not DBNull.Value.Equals(row.Item("newDate")) Then
                    strComment += " New Date: " & row.Item("newDate")
                End If

                sb2.Append("<tr><td style=""background: white; padding: .75pt .75pt .75pt .75pt"">Order</td><td style=""background: white; padding: .75pt .75pt .75pt .75pt""> " & strComment & "</td></tr>")

                db.NonQuery("UPDATE warehouseTransactions SET eMailFailureSent = 1, eMailFailureDate = getdate() WHERE transactionID = " & row.Item("transactionID"))

            Next

            sb2.Append("<tr><td style=""background: white; padding: .75pt .75pt .75pt .75pt"">Date</td><td style=""background: white; padding: .75pt .75pt .75pt .75pt"">" & DateTime.Now.ToShortDateString() & "</td></tr>")
            sb2.Append("<tr><td style=""background: white; padding: .75pt .75pt .75pt .75pt"">Intended Action: </td><td style=""background: white; padding: .75pt .75pt .75pt .75pt"">Please review the transactions in Oracle.</td></tr>")

            sb2.Append("</table>")
            If Not DBNull.Value.Equals(rowCr.Item("eMail")) Then

                Dim strRecipent As String = rowCr.Item("eMail").ToString

                sb.Append("EXEC msdb.dbo.sp_send_dbmail @recipients='" & strRecipent & "',")
                sb.Append("@subject = 'Update transaction failure',")
                sb.Append("@body = '" & sb2.ToString & "', ")
                sb.Append("@body_format = 'HTML'")

                db.SecureNonQueryParams(sb.ToString())
            End If
            

        Next

    End Sub






