		'                 (i.ORGANIZATION_ID = 881) AND (i.PLANNING_MAKE_BUY_CODE = 2) AND (i.MRP_PLANNING_CODE <> 6) AND (i.ITEM_TYPE NOT LIKE 'REF') AND 
		'                 (i.WIP_SUPPLY_TYPE <> 4) AND (i.SAFETY_STOCK_QUANTITY > 0)
