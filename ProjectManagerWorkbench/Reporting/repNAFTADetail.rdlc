<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="TrainerConnectionString">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=(local);Initial Catalog=TrxMonitor;Persist Security Info=True;User ID=WorkBenchUser;Password=WorkBench</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>0cf32fad-3999-4ef8-a9c0-1cf7de6e2d1c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsNAFTA_DataTable1">
      <Query>
        <DataSourceName>TrainerConnectionString</DataSourceName>
        <CommandText>SELECT     dbo.NAFTA.itemNo AS Item, dbo.tblWork.Text2 AS Description, dbo.tblWork.Number3 AS PurMfg, dbo.tblWork.Number2 AS QtyPer, 
                      dbo.tblWork.Number8 AS Cost, dbo.NAFTA.vendorNo, dbo.NAFTA.tariff, dbo.NAFTA.prefCriterion AS Criteria, dbo.NAFTA.netCost, dbo.NAFTA.producer, 
                      dbo.NAFTA.countryOfOrigin AS Country, dbo.NAFTA.NAFTAPart AS Qualify
FROM         dbo.NAFTA INNER JOIN
                      dbo.tblWork ON dbo.NAFTA.itemNo = dbo.tblWork.Text1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item">
          <DataField>Item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
