        <Field Name="netCost">
          <DataField>netCost</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="producer">
          <DataField>producer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Country">
          <DataField>Country</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Qualify">
          <DataField>Qualify</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>TrainerConnectionString</DataSourceName>
        <CommandText>SELECT     dbo.NAFTA.itemNo AS Item, dbo.tblWork.Text2 AS Description, dbo.tblWork.Number3 AS PurMfg, dbo.tblWork.Number2 AS QtyPer, 
                      dbo.tblWork.Number8 AS Cost, dbo.NAFTA.vendorNo, dbo.NAFTA.tariff, dbo.NAFTA.prefCriterion AS Criteria, dbo.NAFTA.netCost, dbo.NAFTA.producer, 
                      dbo.NAFTA.countryOfOrigin AS Country, dbo.NAFTA.NAFTAPart AS Qualify
FROM         dbo.NAFTA INNER JOIN
                      dbo.tblWork ON dbo.NAFTA.itemNo = dbo.tblWork.Text1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>dsNAFTA</rd:DataSetName>
        <rd:TableName>DataTable1</rd:TableName>
        <rd:TableAdapterName>DataTable1TableAdapter</rd:TableAdapterName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
