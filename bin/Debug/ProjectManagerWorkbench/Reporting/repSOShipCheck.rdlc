    <DataSet Name="dsOrderShipping_sales_orders">
      <Query>
        <DataSourceName>FLOWConnectionString</DataSourceName>
        <CommandText>SELECT     ORDER_NO, LINE_NO, ITEM_NO, DESCRIPTION, ORDERED_QUANTITY, SHIPPED_QUANTITY, NULL AS planning_make_buy_code, NULL PURCHASE_ORDER_LINE, NULL QUANTITY_RECEIVED, NULL Vendor_name, NULL voucher_num, NULL invoice_num 
