  <DataSets>
    <DataSet Name="dsOrderShippingPO_DataTable1">
      <Query>
        <DataSourceName>FLOWConnectionString</DataSourceName>
        <CommandText>SELECT 
NULL po_no
,NULL line_no
, NULL item_id
, NULL type_lookup_code
, NULL item_description
, NULL quantity_ordered
, NULL qty_received
, NULL printed_date 
, NULL vendor_name
, NULL country
, NULL running_count_poLines
, NULL item_no
FROM sales_orders</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
