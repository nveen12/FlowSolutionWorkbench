    </Flow_Solution_Workbenches.My.MySettings>
  </userSettings>
  <applicationSettings>
    <Flow_Solution_Workbenches.My.MySettings>
      <setting name="smtpMailhost" serializeAs="String">
        <value>mail.pleugerindustries.com</value>
      </setting>
      <setting name="prodMachineRecognizeName" serializeAs="String">
        <value>denatbdbp01</value>
