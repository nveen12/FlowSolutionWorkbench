      </setting>
      <setting name="projectManagerWorkbenchSc1" serializeAs="String">
        <value>0, 0</value>
      </setting>
      <setting name="projectManagerWorkbenchSc2" serializeAs="String">
        <value>0, 0</value>
      </setting>
      <setting name="projectManagerWorkbenchSc1SplitterDistance" serializeAs="String">
        <value>253</value>
      </setting>
      <setting name="projectManagerWorkbenchSc2SplitterDistance" serializeAs="String">
        <value>225</value>
      </setting>
      <setting name="discussionTrackingSc1Panel1" serializeAs="String">
        <value>0, 0</value>
      </setting>
      <setting name="discussionTrackingSc1Panel2" serializeAs="String">
        <value>0, 0</value>
      </setting>
      <setting name="discussionTrackingSc2Panel1" serializeAs="String">
        <value>0, 0</value>
      </setting>
      <setting name="discussionTrackingSc2Panel2" serializeAs="String">
